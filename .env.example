# Variables d'environnement du site Umdeny Capital.
# Copier en .env.local pour le développement (ce fichier n'est jamais lu par Next).

# ---------------------------------------------------------------
# Mode maintenance
# ---------------------------------------------------------------
# "1" = toutes les URLs rendent la page de maintenance.
# Toute autre valeur, ou variable absente, = site normal.
# Sur Vercel : 1 en Production (main), 0 en Preview.
MAINTENANCE_MODE=0

# ---------------------------------------------------------------
# Supabase — candidatures apporteur d'affaires
# ---------------------------------------------------------------
# Projet mutualisé, un schéma par projet. Celui-ci écrit dans
# umdeny_apporteur, à côté de umdeny_quiz, vireel et cherryz.
#
# Mêmes noms de variables que quiz-umdeny, pour rester homogène.
# Aucune variable NEXT_PUBLIC_ : ce préfixe exposerait la valeur au navigateur,
# or la clé service_role contourne RLS.
SUPABASE_URL=https://naebgecmohzkqfediuyn.supabase.co
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------
# Resend — emails de candidature
# ---------------------------------------------------------------
# Si RESEND_API_KEY est absente, aucun email n'est envoyé : la candidature est
# tout de même enregistrée, et un avertissement est journalisé.
RESEND_API_KEY=

# Expéditeur. Le domaine doit être vérifié dans Resend (enregistrements DKIM
# et SPF à ajouter chez O2Switch, qui gère le DNS d'umdeny.com).
EMAIL_FROM=Umdeny Capital <candidatures@umdeny.com>

# Destinataire interne des candidatures.
EMAIL_TEAM=partner@umdeny.com
