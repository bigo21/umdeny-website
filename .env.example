# Variables d'environnement du site Umdeny Capital.
# Copier en .env.local pour le développement (ce fichier n'est jamais lu par Next).

# ---------------------------------------------------------------
# Mode maintenance
# ---------------------------------------------------------------
# "1" = toutes les URLs rendent la page de maintenance.
# Toute autre valeur, ou variable absente, = site normal.
# Sur Vercel : 1 en Production (main), 0 en Preview.
MAINTENANCE_MODE=0

# ---------------------------------------------------------------
# Supabase — candidatures apporteur d'affaires
# ---------------------------------------------------------------
# Projet mutualisé, un schéma par projet. Celui-ci écrit dans
# umdeny_apporteur, à côté de umdeny_quiz, vireel et cherryz.
#
# Mêmes noms de variables que quiz-umdeny, pour rester homogène.
# Aucune variable NEXT_PUBLIC_ : ce préfixe exposerait la valeur au navigateur,
# or la clé service_role contourne RLS.
SUPABASE_URL=https://naebgecmohzkqfediuyn.supabase.co
SUPABASE_SERVICE_KEY=

# Clé anon, utilisée pour appeler l'Edge Function inscription-webinaire.
# Publique par conception — elle pourrait vivre dans le navigateur. On la garde
# malgré tout côté serveur : la page passe par un relais interne
# (/api/inscription-webinaire), ce qui évite d'introduire la première variable
# NEXT_PUBLIC_ du dépôt.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Resend — emails de candidature
# ---------------------------------------------------------------
# Si RESEND_API_KEY est absente, aucun email n'est envoyé : la candidature est
# tout de même enregistrée, et un avertissement est journalisé.
RESEND_API_KEY=

# Expéditeur. Le domaine doit être vérifié dans Resend (enregistrements DKIM
# et SPF à ajouter chez O2Switch, qui gère le DNS d'umdeny.com).
EMAIL_FROM=Umdeny Capital <candidatures@umdeny.com>

# Destinataire interne des candidatures.
EMAIL_TEAM=partner@umdeny.com

# ---------------------------------------------------------------
# Page d'administration des webinaires (/admin)
# ---------------------------------------------------------------
# Deux secrets DISTINCTS, à ne pas confondre.
#
# ADMIN_PASSWORD protège l'accès humain : c'est ce qui est saisi dans le
# formulaire de /admin. Il sert aussi de clé de signature du cookie de session,
# donc le changer déconnecte immédiatement toutes les sessions ouvertes — c'est
# ce qu'on attend d'une rotation.
#
# Sur Vercel, une variable d'environnement ne prend effet qu'après un
# redéploiement : une rotation n'est PAS instantanée. À savoir avant d'en avoir
# besoin en urgence.
ADMIN_PASSWORD=

# ADMIN_WEBINAIRE_SECRET protège l'API : en-tête X-Admin-Secret de l'Edge
# Function admin-webinaire. Il ne doit jamais atteindre le navigateur — les
# appels partent du serveur, comme pour l'inscription. Compromettre le mot de
# passe ne donne pas ce secret, et réciproquement.
ADMIN_WEBINAIRE_SECRET=
