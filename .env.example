# Variables d'environnement du site Umdeny Capital.
# Copier en .env.local pour le développement (ce fichier n'est jamais lu par Next).

# ---------------------------------------------------------------
# Mode maintenance
# ---------------------------------------------------------------
# "1" = toutes les URLs rendent la page de maintenance.
# Toute autre valeur, ou variable absente, = site normal.
# Sur Vercel : 1 en Production (main), 0 en Preview.
MAINTENANCE_MODE=0

# ---------------------------------------------------------------
# Supabase — stockage des candidatures apporteur d'affaires
# ---------------------------------------------------------------
# Aucune variable NEXT_PUBLIC_ ici : ce préfixe exposerait la valeur au
# navigateur. La clé secrète contourne RLS, elle reste strictement serveur.
#
# En local : les valeurs sont données par `supabase status -o env`
#   SUPABASE_URL        <- API_URL
#   SUPABASE_SECRET_KEY <- SECRET_KEY
#
# En production : Dashboard Supabase > Project Settings > API keys.
# Utiliser une clé au format sb_secret_... (les clés JWT service_role sont
# dépréciées fin 2026).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------
# Resend — emails de candidature
# ---------------------------------------------------------------
# Si RESEND_API_KEY est absente, aucun email n'est envoyé : la candidature est
# tout de même enregistrée en base, et un avertissement est journalisé.
RESEND_API_KEY=

# Expéditeur. Le domaine doit être vérifié dans Resend (enregistrements DKIM
# et SPF à ajouter chez O2Switch, qui gère le DNS d'umdeny.com).
RESEND_FROM=Umdeny Capital <candidatures@umdeny.com>
